{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflare.local/tyagaraja/schema/raga.schema.json",
  "title": "Raga reference",
  "description": "Melakarta and janya ragas used across the kriti collection.",
  "type": "object",
  "required": ["version", "updated", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/raga" } }
  },
  "$defs": {
    "raga": {
      "type": "object",
      "required": ["slug", "name", "name_telugu", "aka", "type", "mela", "parent", "arohana", "avarohana", "scale_type", "chakra", "mood", "notes"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "name_telugu": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 60,
          "description": "The raga name in Telugu script, as printed in Telugu Carnatic songbooks — not a mechanical transliteration. Null where not confidently known."
        },
        "aka": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 60 },
          "description": "Alternate names a student is likely to hear — Tōḍi for Hanumatōḍi, Pantuvarāḷi for Kāmavardhini. Searchable in the app."
        },
        "type": { "type": "string", "enum": ["melakarta", "janya"] },
        "mela": { "type": ["integer", "null"], "minimum": 1, "maximum": 72 },
        "parent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Slug of the parent melakarta. A melakarta record points at itself."
        },
        "arohana": {
          "type": "string",
          "pattern": "^S( (S|R1|R2|R3|G1|G2|G3|M1|M2|P|D1|D2|D3|N1|N2|N3))+$",
          "description": "Space-separated swara sthanas, ascending, ending on the upper S."
        },
        "avarohana": {
          "type": "string",
          "pattern": "^S( (S|R1|R2|R3|G1|G2|G3|M1|M2|P|D1|D2|D3|N1|N2|N3))+$",
          "description": "Space-separated swara sthanas, descending from the upper S."
        },
        "scale_type": { "type": "string", "enum": ["sampurna", "audava", "shadava", "vakra", "bhashanga", "varja"] },
        "chakra": {
          "type": ["string", "null"],
          "enum": ["Indu", "Netra", "Agni", "Veda", "Bana", "Rutu", "Rishi", "Vasu", "Brahma", "Disi", "Rudra", "Aditya", null]
        },
        "mood": { "type": ["string", "null"], "maxLength": 240 },
        "notes": { "type": ["string", "null"], "maxLength": 700 }
      }
    }
  }
}
