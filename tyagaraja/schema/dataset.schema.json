{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflare.local/tyagaraja/schema/dataset.schema.json",
  "title": "Dataset manifest",
  "description": "Ties the data files to their schemas and pins each file's record count and content hash.",
  "type": "object",
  "required": ["name", "version", "schema_version", "updated", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "provenance": { "type": "string", "maxLength": 900 },
    "files": {
      "type": "object",
      "required": ["kritis", "ragas", "talas", "groups"],
      "additionalProperties": false,
      "properties": {
        "kritis": { "$ref": "#/$defs/file" },
        "ragas": { "$ref": "#/$defs/file" },
        "talas": { "$ref": "#/$defs/file" },
        "groups": { "$ref": "#/$defs/file" }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "schema", "count", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9._/-]+\\.json$" },
        "schema": { "type": "string", "pattern": "^[a-z0-9._/-]+\\.json$" },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
