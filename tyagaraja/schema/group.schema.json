{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflare.local/tyagaraja/schema/group.schema.json",
  "title": "Kriti group reference",
  "description": "Named sets of kritis - pancharatnas, utsava sampradaya, divya nama, the operas, kshetra sets.",
  "type": "object",
  "required": ["version", "updated", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/group" } }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": ["slug", "name", "kind", "expected_count", "summary", "study_note"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "kind": { "type": "string", "enum": ["pancharatna", "collection", "opera", "kshetra"] },
        "expected_count": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Canonical size where the set is closed (5 for a pancharatna). null where the count is open or disputed."
        },
        "summary": { "type": "string", "minLength": 20, "maxLength": 900 },
        "study_note": { "type": ["string", "null"], "maxLength": 400 }
      }
    }
  }
}
