{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflare.local/tyagaraja/schema/tala.schema.json",
  "title": "Tala reference",
  "description": "The talas used in kriti attributions, with anga structure and how to count them.",
  "type": "object",
  "required": ["version", "updated", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tala" } }
  },
  "$defs": {
    "tala": {
      "type": "object",
      "required": ["slug", "name", "label", "aksharas", "angas", "counting", "jati", "notes"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 40 },
        "label": {
          "type": "string",
          "enum": ["Adi", "Rupaka", "Misra Chapu", "Khanda Chapu", "Desadi", "Madhyadi", "Ata", "Jhampa", "Triputa", "Eka", "Matya"],
          "description": "The exact string used in a kriti's `tala` field."
        },
        "aksharas": { "type": "integer", "minimum": 3, "maximum": 32 },
        "angas": { "type": "string", "minLength": 1, "maxLength": 120 },
        "counting": { "type": "string", "minLength": 10, "maxLength": 400 },
        "jati": { "type": ["string", "null"], "enum": ["Tisra", "Chatusra", "Khanda", "Misra", "Sankirna", null] },
        "notes": { "type": ["string", "null"], "maxLength": 700 }
      }
    }
  }
}
