rules_version = '2';

/* myflare — Firestore security rules.
 *
 * Paste into Firebase console → Firestore Database → Rules → Publish.
 *
 * This file, not the JavaScript in auth/, is what actually enforces access.
 * The client-side gate decides what *renders*; these rules decide what the
 * Firebase backend is willing to hand over, and they hold even against a
 * browser with the gate ripped out.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function signedIn() {
      return request.auth != null;
    }

    function viaGoogle() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    /* On the allowlist: a document named after the caller's own verified
     * address exists, and isn't switched off. */
    function allowListed() {
      return viaGoogle()
        && exists(/databases/$(database)/documents/allowlist/$(myEmail()))
        && get(/databases/$(database)/documents/allowlist/$(myEmail())).data.get('disabled', false) == false;
    }

    /* ---------- the allowlist itself ---------- */

    /* A signed-in account may read exactly one document: the one named after
     * its own verified email. That is enough for the gate to ask "am I on the
     * list?", while making the list impossible to enumerate — you cannot read
     * anyone else's entry, or discover who else has access.
     *
     * Writes are console-only. Add or remove access at
     * Firestore Database → Data → allowlist. */
    match /allowlist/{email} {
      allow read: if viaGoogle() && email == myEmail();
      allow write: if false;
    }

    /* ---------- sub-project data ---------- */

    /* Portfolio Tracker and Wallet predate the gate. Each initialises its own
     * Firebase app with a config you paste into its Settings panel and then
     * calls signInAnonymously(), so those requests arrive with no email and
     * cannot be allow-listed by address. Both encrypt client-side with a
     * passphrase before uploading, so what is stored here is ciphertext.
     *
     * These two rules keep them working as they do today: any signed-in
     * caller, anonymous included. That is weaker than the rest of this file —
     * it means anyone who signs in anonymously to this project can fetch the
     * ciphertext, though not read it without the passphrase.
     *
     * To tighten: change `signedIn()` to `allowListed()` here, and change
     * those two apps to reuse the gate's Google session instead of signing in
     * anonymously. Doing it in the other order locks you out of your own data. */
    match /portfolio-tracker/{doc} {
      allow read, write: if signedIn();
    }

    match /wallet_cards/{doc} {
      allow read, write: if signedIn();
    }

    /* ---------- everything else ---------- */

    /* Deliberately NOT a `match /{document=**}` catch-all. Firestore evaluates
     * every matching rule and grants if *any* of them allows, so a recursive
     * catch-all cannot be narrowed by the specific rules above — it would union
     * with them and hand allow-listed users write access to /allowlist itself,
     * letting anyone with access add anyone else. Grants have to stay scoped.
     *
     * This is the namespace for future gated data: anything under /private is
     * allow-listed, and nothing else is reachable at all. */
    match /private/{document=**} {
      allow read, write: if allowListed();
    }
  }
}
